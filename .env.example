# ============================================
#   DERIV RSI BOT — ENVIRONMENT CONFIG
#   NEW API (2026) — developers.deriv.com
# ============================================

# ── STEP 1: PAT Token ──────────────────────
# Go to: developers.deriv.com/dashboard/tokens
# Create token → check Trade + Account management → Copy it here
DERIV_API_TOKEN=YOUR_PAT_TOKEN_HERE

# ── STEP 2: App ID ─────────────────────────
# Go to: developers.deriv.com/dashboard
# Click "Registered Apps" → Register new app (PAT type) → Copy the App ID here
DERIV_APP_ID=YOUR_APP_ID_HERE

# ── STEP 3: Account ID ─────────────────────
# The bot will fetch this automatically on first run and print it.
# Then paste it here (starts with VRTC for demo, CR for real)
DERIV_ACCOUNT_ID=YOUR_ACCOUNT_ID_HERE

# Trading Symbol — Synthetic Indices (NEW symbol names):
#   1HZ10V  = Volatility 10 Index
#   1HZ25V  = Volatility 25 Index
#   1HZ50V  = Volatility 50 Index
#   1HZ75V  = Volatility 75 Index  ← recommended for bots
#   1HZ100V = Volatility 100 Index
SYMBOL=1HZ75V

# Stake per trade in USD
STAKE=1

# Max number of open/active trades at once
MAX_ACTIVE_TRADES=1

# Stop bot if account balance drops below this USD value
STOP_LOSS_BALANCE=50

# RSI Settings
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Contract duration (in minutes)
CONTRACT_DURATION=1

# How many ticks to collect before starting to trade
MIN_TICKS_REQUIRED=20

